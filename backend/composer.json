{
  "name": "ka2/manage-ka2-org",
  "description": "manage.ka2.org(ヘッドレス CMS 用 WordPress)。コアとプラグインはバージョン固定で管理する",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    { "type": "composer", "url": "https://wpackagist.org", "only": ["wpackagist-plugin/*", "wpackagist-theme/*"] }
  ],
  "require": {
    "php": ">=8.4",
    "johnpbloch/wordpress-core": "7.1.4",
    "johnpbloch/wordpress-core-installer": "^2.0",
    "wpackagist-plugin/flamingo": "*"
  },
  "require-dev": {
    "wp-cli/wp-cli-bundle": "*"
  },
  "extra": {
    "wordpress-install-dir": "public/wp",
    "installer-paths": {
      "public/content/plugins/{$name}/": ["type:wordpress-plugin"],
      "public/content/themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "config": {
    "platform": { "php": "8.4" },
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    }
  }
}
