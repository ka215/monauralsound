# ビルド時に WP REST を取得する接続先(末尾スラッシュなし)
NUXT_WP_API_BASE=http://localhost:8081/wp-json
# 既定値は nuxt.config.ts(既存 ID を継承)。環境ごとに上書きする場合のみ設定する
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NUXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NUXT_PUBLIC_ADSENSE_SLOT=

# ダミー広告枠の表示(レイアウト確認用)
NUXT_PUBLIC_ADSENSE_DEBUG=false

# 問い合わせ API と Turnstile(既定は本番 API とテスト用サイトキー)
# NUXT_PUBLIC_CONTACT_API=http://localhost:8081/wp-json/ka2/v1/contact
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
